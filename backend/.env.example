# AI Personal Call Agent Backend Configuration
# Environment Variables & API Keys

# Application
PROJECT_NAME="AI Personal Call Agent"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# AI Voice Agent (OpenAI API for LLM reasoning, STT whisper, TTS)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL="gpt-4o-mini"
OPENAI_VOICE="alloy"

# Telephony Configuration (Exotel)
EXOTEL_API_KEY="your_exotel_api_key_here"
EXOTEL_API_TOKEN="your_exotel_api_token_here"
EXOTEL_ACCOUNT_SID="your_exotel_account_sid_here"
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_VIRTUAL_NUMBER="+918047100000"
EXOTEL_SMS_SENDER_ID="EXOTEL"

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH="./firebase/service-account.json"
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Telephony Configuration (General / Fallback)
TELEPHONY_PROVIDER="exotel"
TELEPHONY_ACCOUNT_ID=your_telephony_account_sid
TELEPHONY_AUTH_TOKEN=your_telephony_auth_token
TELEPHONY_PHONE_NUMBER="+1234567890"
TELEPHONY_WEBHOOK_URL="https://api.yourdomain.com/webhooks/telephony/incoming"

# SMS Alert Provider (Provider: twilio | exotel | plivo | mock)
SMS_PROVIDER="twilio"
SMS_ACCOUNT_ID=your_sms_account_sid
SMS_AUTH_TOKEN=your_sms_auth_token
SMS_FROM_NUMBER="+1234567890"
OWNER_PHONE_NUMBER="+917367966177"

# WhatsApp Business Platform / Cloud API (Meta)
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id_here"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id_here"
WHATSAPP_RECIPIENT_PHONE_NUMBER="+917367966177"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ai_call_agent_verify_token_2026"
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_TEMPLATE_NAME="urgent_call_alert"
WHATSAPP_TEMPLATE_LANG="en_US"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_call_agent"

# Security & JWT
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY="32_byte_base64_encryption_key_here"

# Alert Cooldown & Rate Limiting
ALERT_COOLDOWN_MINUTES=5
MAX_CALL_DURATION_SECONDS=300
DEMO_MODE=true
